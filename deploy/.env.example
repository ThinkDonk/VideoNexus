# =============================================================================
# VideoNexus 门户环境变量清单（示例文件）
# -----------------------------------------------------------------------------
# 用法：cp .env.example .env，然后按注释逐项填写。
#   - 后端变量：与 backend/app/config.py 的 Settings 字段一一对应（字段名同名，
#     大小写不敏感）；由 docker-compose 的 env_file: .env 注入 portal-backend。
#   - compose 侧变量（ZLM_UPSTREAM）：由 compose 插值注入 portal-web（nginx 模板）。
# 安全提示：.env 已被 .gitignore 忽略，请勿提交；泄露 JWT_SECRET 等于泄露全部会话。
# =============================================================================

# ------------------------------ 安全 / 会话 ----------------------------------
# JWT 会话签名密钥【必填】。生成方式：openssl rand -hex 48
# 不配置时后端每次重启随机生成 -> 重启后全员登录态失效，生产必须显式配置
JWT_SECRET=
# 登录态有效期（小时）；后端做滑动续期（剩余不足一半时自动续）
JWT_TTL_HOURS=2
# true=对外是 HTTPS 入口，后端签发 wss:// 播放地址；false 签发 ws://（仅内网纯 HTTP 调试时改 false）
PUBLIC_HTTPS=true
# true=同一账号新登录踢掉旧会话；false=允许多端同时在线
SINGLE_SESSION=false

# ------------------------------ 登录安全 -------------------------------------
# 连续登录失败达到上限后锁定账号
LOGIN_MAX_FAILURES=5
# 锁定时长（分钟）
LOGIN_LOCK_MINUTES=30

# ------------------------------ WVP 平台 -------------------------------------
# WVP-GB28181-pro 管理平台地址（内网可达即可，不要暴露公网）
WVP_BASE_URL=http://192.168.1.100:18080
# WVP 接口 API Key【推荐】（WVP 管理端：用户管理 -> 对应用户的 API Key）
WVP_API_KEY=
# 未配置 API Key 时回退为账号密码自动登录换取 token
WVP_USERNAME=
WVP_PASSWORD=
# WVP 请求超时（秒）；点播/回放为异步接口，需覆盖其 play-timeout，不要调小
WVP_REQUEST_TIMEOUT=70

# ------------------------------ ZLM 流媒体 -----------------------------------
# 可选：改写 WVP 返回的 ZLM 下载直链 host（门户后端拉取录像文件用）；
# 留空则使用 WVP 返回的原始地址
ZLM_DOWNLOAD_BASE_URL=
# ZLM 流媒体 API 密钥（与 ZLM 配置文件 api.secret 一致）
ZLM_SECRET=

# ------------------------------ 初始管理员 -----------------------------------
# 首次启动且库中无管理员时创建；密码留空则随机生成并打印到后端日志一次
INITIAL_ADMIN_USERNAME=admin
# 建议首启前就设好强密码；无论哪种方式，首次登录后请立即修改
INITIAL_ADMIN_PASSWORD=

# ------------------------------ 业务参数 -------------------------------------
# 通道信息同步周期（分钟）
CHANNEL_SYNC_MINUTES=5
# 播放会话最长存续（小时），超时由清理任务关闭
PLAY_SESSION_MAX_HOURS=12
# GB28181 录像下载倍速
DOWNLOAD_SPEED=4
# 单次下载时间段上限（小时）
DOWNLOAD_MAX_DURATION_HOURS=4
# 每用户同时进行的下载任务数上限
DOWNLOAD_MAX_RUNNING_PER_USER=2
# 下载进度轮询间隔（秒）
DOWNLOAD_POLL_SECONDS=10
# 下载文件保留天数，过期自动清理
FILE_RETENTION_DAYS=7
# 机构下载文件存储配额（GB）
ORG_DEFAULT_QUOTA_GB=50

# ------------------------------ 容器运行 -------------------------------------
# 时区（数据库 naive 时间口径、备份计划、日志时间均依赖它，保持 Asia/Shanghai）
TZ=Asia/Shanghai
# 数据目录：容器内固定为 /data（对应命名卷 portal-data），请勿修改
DATA_DIR=/data

# ------------------------------ 可选高级 -------------------------------------
# 数据库连接串。留空则自动使用 sqlite+aiosqlite:////data/portal.db（见 config.py）；
# 仅在后期切换 MySQL 时按 requirements.txt 注释启用 asyncmy 后另行配置
# DATABASE_URL=

# ------------------------------ compose 侧 -----------------------------------
# 【必填】ZLM 流媒体 HTTP 端口完整 URL（必须含 http:// 前缀；nginx 将 /stream/
# 鉴权后 proxy_pass 到这里）。注意是 ZLM 的 HTTP API 端口（通常 8080），
# 不是 RTMP/RTSP 端口
ZLM_UPSTREAM=http://192.168.1.100:8080
