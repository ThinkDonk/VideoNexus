# 统一换行符：仓库内一律使用 LF，避免 Windows 检出的 CRLF 导致
# shell 脚本在 Linux 容器内启动失败（如 deploy/*.sh 出现 "bad interpreter"）
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary
*.db binary
*.sqlite binary

# 明确要求 LF 的文本类型
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
